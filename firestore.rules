rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function acctPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function acctExists() { return signedIn() && exists(acctPath()); }
    function acct() { return get(acctPath()).data; }
    function isActiveAcct() { return acctExists() && acct().isActive != false; }
    function isAdmin() { return isActiveAcct() && acct().role == 'admin'; }
    function isTeam() { return isActiveAcct() && acct().role == 'team'; }
    function isVendor() { return isActiveAcct() && acct().role == 'vendor'; }
    function myUserId() { return acct().userId; }
    function myChannel() { return acct().channelId; }
    function memberOf(cid) {
      return isAdmin() || (acctExists() && cid != null
        && myUserId() in get(/databases/$(database)/documents/channels/$(cid)).data.memberIds);
    }

    // Caller-maintained mirror of role/channel, validated against the canonical
    // users doc so it can't be forged. A newly authenticated user can read AND
    // create their own mirror (first-time setup).
    match /accounts/{uid} {
      function src() { return get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data; }
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && src().authUid == request.auth.uid
        && request.resource.data.role == src().role
        && request.resource.data.isActive == src().isActive
        && (src().role != 'vendor' || request.resource.data.channelId == src().channelId);
    }

    match /users/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.authUid == request.auth.uid);
      allow update: if isAdmin()
        // First-time link: attach own authUid to a matching unlinked record.
        || (resource.data.authUid == null
            && request.resource.data.authUid == request.auth.uid
            && resource.data.phone == request.auth.token.phone_number)
        // Self profile edit: cannot change role/channel/active.
        || (resource.data.authUid == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.channelId == resource.data.channelId
            && request.resource.data.isActive == resource.data.isActive);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin() || isTeam() || (isVendor() && resource.data.channelId == myChannel());
      allow create: if isAdmin() || isTeam();
      allow update: if isAdmin() || isTeam() || (isVendor() && resource.data.channelId == myChannel());
      allow delete: if isAdmin();
    }

    match /channels/{cid} {
      allow read: if isAdmin() || (acctExists() && myUserId() in resource.data.memberIds);
      allow create: if isAdmin();
      allow update: if isAdmin() || isTeam() || (acctExists() && myUserId() in resource.data.memberIds);
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin() || memberOf(resource.data.channelId);
      allow create: if isAdmin() || memberOf(request.resource.data.channelId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && (isAdmin() || resource.data.userId == myUserId());
      allow create: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == myUserId());
    }

    match /counters/{id} {
      allow read, write: if signedIn();
    }
  }
}
