rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The caller's user profile (matched by authUid). Used for role checks.
    function profile() {
      return get(/databases/$(database)/documents/users/$(callerDocId())).data;
    }
    // NOTE: callerDocId() can't be resolved by a query in rules, so we instead
    // store role on a claim or look up by a deterministic id. For simplicity in
    // this build, role checks are coarse-grained and rely on signed-in users.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users: anyone signed-in can read (needed for vendor/member lookups);
    // bootstrap + first-time setup require write. Tighten with custom claims
    // in production.
    match /users/{id} {
      allow read: if true; // login flow needs to find a user by phone/email
      allow create: if true; // admin add-member + bootstrap + first-time linking
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /orders/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /channels/{id} {
      allow read, write: if signedIn();
    }

    match /messages/{id} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }
  }
}
