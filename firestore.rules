rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role/channel come from custom claims on the auth token, set by the
    // resolveProfile Cloud Function. No cross-document get() calls = robust.
    function signedIn() { return request.auth != null; }
    function claimsReady() { return signedIn() && request.auth.token.role != null; }
    function active() { return claimsReady() && request.auth.token.isActive != false; }
    function isAdmin() { return active() && request.auth.token.role == 'admin'; }
    function isTeam() { return active() && request.auth.token.role == 'team'; }
    function myUserId() { return request.auth.token.userId; }
    function inMyChannels(cid) {
      return active() && cid != null && (cid in request.auth.token.channels);
    }

    match /users/{id} {
      // Readable to signed-in users (login lookups happen server-side already).
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.authUid == request.auth.uid);
      // Admin can edit anyone; a user can edit their own doc but NOT change
      // role/channel/active. (authUid linking is done server-side.)
      allow update: if isAdmin()
        || (resource.data.authUid == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.channelId == resource.data.channelId
            && request.resource.data.isActive == resource.data.isActive);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin() || inMyChannels(resource.data.channelId);
      allow create: if isAdmin() || (isTeam() && inMyChannels(request.resource.data.channelId));
      allow update: if isAdmin() || inMyChannels(resource.data.channelId);
      allow delete: if isAdmin();
    }

    match /channels/{cid} {
      allow read: if isAdmin() || (active() && myUserId() in resource.data.memberIds);
      allow create: if isAdmin();
      allow update: if isAdmin() || (active() && myUserId() in resource.data.memberIds);
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin() || inMyChannels(resource.data.channelId);
      allow create: if isAdmin() || inMyChannels(request.resource.data.channelId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && (isAdmin() || resource.data.userId == myUserId());
      allow create: if signedIn(); // an order/message notifies other users
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == myUserId());
    }

    // Monotonic order-number counter.
    match /counters/{id} {
      allow read, write: if signedIn();
    }
  }
}
